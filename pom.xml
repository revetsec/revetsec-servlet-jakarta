<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.revetsec</groupId>
	<artifactId>revetsec-servlet-jakarta</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>Revetsec Servlet Adapter (jakarta)</name>
	<description>Revetsec helpers for jakarta.servlet applications: they pass HttpServletRequests to Revetsec core as raw input and write Revetsec results to HttpServletResponses.</description>
	<url>https://github.com/revetsec/revetsec-servlet-jakarta</url>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Mark Allen</name>
			<email>mark@revetware.com</email>
			<organization>Revetware LLC</organization>
			<organizationUrl>https://www.revetware.com</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git@github.com:revetsec/revetsec-servlet-jakarta.git</connection>
		<developerConnection>scm:git:git@github.com:revetsec/revetsec-servlet-jakarta.git</developerConnection>
		<url>https://github.com/revetsec/revetsec-servlet-jakarta</url>
	</scm>

	<!-- Sibling precedent. SNAPSHOTs are not published unless the owner authorizes it (D48). -->
	<distributionManagement>
		<repository>
			<name>Central Portal Snapshots</name>
			<id>central-portal-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.build.outputTimestamp>2026-09-01T00:00:00Z</project.build.outputTimestamp>

		<!-- Adapter 1.x requires Revetsec core 1.0.0 or later. Until core 1.0.0 is released, CI builds core from
		     the commit pinned in .github/workflows/ci.yml, and scripts/verify-core-drift.py checks that the pinned
		     core's version equals this property. Never override it on the command line. -->
		<revetsec.version>1.0.0-SNAPSHOT</revetsec.version>
		<!-- The Jakarta Servlet API (Servlet 6.1, plan 10.1). The servlet container supplies it at runtime. -->
		<jakarta.servlet.version>6.1.0</jakarta.servlet.version>

		<!-- Build plugins (the same versions as Revetsec core) -->
		<maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
		<maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
		<maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
		<maven.source.plugin.version>3.4.0</maven.source.plugin.version>
		<maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
		<maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
		<maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
		<central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>

		<!-- Analysis profiles -->
		<error.prone.version>2.50.0</error.prone.version>
		<nullaway.version>0.14.1</nullaway.version>
		<spotbugs.maven.plugin.version>4.10.4.1</spotbugs.maven.plugin.version>
		<findsecbugs.version>1.14.0</findsecbugs.version>

		<!-- Provided-scope annotations (never compile or runtime scope) -->
		<jspecify.version>1.0.1</jspecify.version>
		<jsr305.version>3.0.2</jsr305.version>
		<error.prone.annotations.version>2.50.0</error.prone.annotations.version>

		<!-- Test scope -->
		<junit.jupiter.version>6.1.3</junit.jupiter.version>

		<!-- The javadoc JAR is built by a separately pinned JDK (REVETSEC_JAVADOC_HOME), as in Revetsec core and
		     Soklet. Every build passes -Dmaven.javadoc.skip=true until this adapter has its first public type. -->
		<revetsec.javadoc.executable>${env.REVETSEC_JAVADOC_HOME}/bin/javadoc</revetsec.javadoc.executable>
		<revetsec.spotbugs.excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</revetsec.spotbugs.excludeFilterFile>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven.enforcer.plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-build-contract</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<dependencyConvergence/>
								<!-- Allow-list (plan 10.1): no compile, runtime or system dependencies at all, and the
								     only provided dependencies are Revetsec core, the jakarta.servlet API and the
								     annotation JARs. Test scope is not restricted; it never reaches the published POM's
								     consumers. -->
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>*:*:*:*:compile</exclude>
										<exclude>*:*:*:*:runtime</exclude>
										<exclude>*:*:*:*:system</exclude>
										<exclude>*:*:*:*:provided</exclude>
									</excludes>
									<includes>
										<include>com.revetsec:revetsec:*:jar:provided</include>
										<include>jakarta.servlet:jakarta.servlet-api:*:jar:provided</include>
										<include>org.jspecify:jspecify:*:jar:provided</include>
										<include>com.google.code.findbugs:jsr305:*:jar:provided</include>
										<include>com.google.errorprone:error_prone_annotations:*:jar:provided</include>
									</includes>
									<message>Revetsec adapters must not declare runtime dependencies. The only provided dependencies are Revetsec core, the jakarta.servlet API and the JSpecify, jsr305 and Error Prone annotations; everything else is test scope.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.plugin.version}</version>
				<configuration>
					<release>17</release>
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-Xlint:all</arg>
					</compilerArgs>
					<!-- No annotation processing in the default build, as in Revetsec core. The static-analysis
					     profile enables it only for Error Prone and NullAway. -->
					<proc>none</proc>
					<showDeprecation>true</showDeprecation>
					<showWarnings>true</showWarnings>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<!-- Only junit-jupiter-api is declared. Surefire detects it and provisions the matching JUnit 6
				     engine and platform launcher itself (Revetsec core and Soklet precedent). -->
				<configuration>
					<includes>
						<include>**/*Tests.java</include>
					</includes>
					<failIfNoTests>true</failIfNoTests>
					<trimStackTrace>false</trimStackTrace>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>${maven.source.plugin.version}</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.plugin.version}</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Automatic-Module-Name>com.revetsec.servlet.jakarta</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven.javadoc.plugin.version}</version>
				<configuration>
					<!-- Documentation uses a separately pinned JDK; compilation still targets 17. Required from this
					     adapter's first public type; until then every build passes -Dmaven.javadoc.skip=true.
					     With the first public type, also link Revetsec core's Javadoc from the pinned core build, as
					     Soklet's adapters do with soklet.javadoc.location. -->
					<javadocExecutable>${revetsec.javadoc.executable}</javadocExecutable>
					<!-- Keep published package URLs stable despite the JAR's automatic module name. -->
					<legacyMode>true</legacyMode>
					<detectJavaApiLink>false</detectJavaApiLink>
					<detectOfflineLinks>false</detectOfflineLinks>
					<offlineLinks>
						<offlineLink>
							<url>https://docs.oracle.com/en/java/javase/26/docs/api/</url>
							<location>${project.basedir}/src/main/javadoc/links/java-26</location>
						</offlineLink>
						<offlineLink>
							<url>https://javadoc.io/static/com.google.code.findbugs/jsr305/3.0.2/</url>
							<location>${project.basedir}/src/main/javadoc/links/jsr305-3.0.2</location>
						</offlineLink>
						<offlineLink>
							<url>https://javadoc.io/static/org.jspecify/jspecify/1.0.1/</url>
							<location>${project.basedir}/src/main/javadoc/links/jspecify-1.0.1</location>
						</offlineLink>
						<offlineLink>
							<url>https://javadoc.io/static/jakarta.servlet/jakarta.servlet-api/6.1.0/</url>
							<location>${project.basedir}/src/main/javadoc/links/jakarta.servlet-api-6.1.0</location>
						</offlineLink>
					</offlineLinks>
					<quiet>true</quiet>
					<notimestamp>true</notimestamp>
					<encoding>UTF-8</encoding>
					<docencoding>UTF-8</docencoding>
					<charset>UTF-8</charset>
					<additionalOptions>
						<additionalOption>-XDignore.symbol.file</additionalOption>
						<additionalOption>-Xdoclint:-html</additionalOption>
					</additionalOptions>
					<linksource>true</linksource>
					<show>public</show>
					<bottom><![CDATA[Copyright 2026 <a href="https://www.revetware.com" target="_blank">Revetware LLC</a>.]]></bottom>
					<source>17</source>
					<failOnError>true</failOnError>
					<overview>${project.basedir}/src/main/javadoc/overview.html</overview>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- Provided: the application declares Revetsec core, and its servlet container supplies the Servlet API
		     (README, "Installation"). -->
		<dependency>
			<groupId>com.revetsec</groupId>
			<artifactId>revetsec</artifactId>
			<version>${revetsec.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.servlet.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Compile-time-only annotations. Nothing is ever compile or runtime scope (enforced above). -->
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>${jspecify.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>${jsr305.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.errorprone</groupId>
			<artifactId>error_prone_annotations</artifactId>
			<version>${error.prone.annotations.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Testing-only dependencies. With the first helper (M12), tests add Soklet's soklet-servlet-jakarta
		     request and response implementations here as test-scope fakes (plan 10.1), not a mocking library. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!--
			Publishing (plan 10.5). Nothing is published without the owner's explicit authorization, `mvn deploy` is
			never run from a developer machine, and this adapter is published only together with or after Revetsec
			core. The Central Portal deployment is left for a manual publish in the Portal UI.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven.gpg.plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central.publishing.plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central-portal</publishingServerId>
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Static-analysis gate, as in Revetsec core. Run on JDK 21 (Error Prone requires JDK 21+ to run); the
			release-17 target is unchanged. NullAway runs at ERROR with com.revetsec as the annotated package, over
			main and test code.

			  JAVA_HOME=<jdk21> mvn -B -ntp -Pstatic-analysis -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>static-analysis</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<fork>true</fork>
							<proc>full</proc>
							<annotationProcessorPaths>
								<path>
									<groupId>com.google.errorprone</groupId>
									<artifactId>error_prone_core</artifactId>
									<version>${error.prone.version}</version>
								</path>
								<path>
									<groupId>com.uber.nullaway</groupId>
									<artifactId>nullaway</artifactId>
									<version>${nullaway.version}</version>
								</path>
							</annotationProcessorPaths>
							<compilerArgs combine.children="append">
								<arg>-Xmaxwarns</arg>
								<arg>100000</arg>
								<arg>-Xmaxerrs</arg>
								<arg>100000</arg>
								<arg>-XDcompilePolicy=simple</arg>
								<arg>--should-stop=ifError=FLOW</arg>
								<arg>-XDaddTypeAnnotationsToSymbol=true</arg>
								<arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=com.revetsec -Xep:DefaultCharset:ERROR -Xep:StringSplitter:ERROR -Xep:StringCaseLocaleUsage:ERROR -Xep:ReferenceEquality:ERROR -Xep:EmptyCatch:ERROR -Xep:NullableVoid:ERROR -Xep:AnnotateFormatMethod:ERROR -Xep:UnusedMethod:ERROR -Xep:UnusedVariable:ERROR -Xep:Finally:ERROR -Xep:NarrowingCompoundAssignment:ERROR -Xep:MissingSummary:OFF</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
								<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
								<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
								<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
							</compilerArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			SpotBugs + FindSecBugs gate, JDK 21, as in Revetsec core. Every entry in the exclude filter needs a
			written reason.

			  JAVA_HOME=<jdk21> mvn -B -ntp -Pspotbugs -Dmaven.javadoc.skip=true verify
		-->
		<profile>
			<id>spotbugs</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<version>${spotbugs.maven.plugin.version}</version>
						<configuration>
							<effort>Max</effort>
							<threshold>Medium</threshold>
							<failOnError>true</failOnError>
							<xmlOutput>true</xmlOutput>
							<excludeFilterFile>${revetsec.spotbugs.excludeFilterFile}</excludeFilterFile>
							<plugins>
								<plugin>
									<groupId>com.h3xstream.findsecbugs</groupId>
									<artifactId>findsecbugs-plugin</artifactId>
									<version>${findsecbugs.version}</version>
								</plugin>
							</plugins>
						</configuration>
						<executions>
							<execution>
								<id>spotbugs-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
