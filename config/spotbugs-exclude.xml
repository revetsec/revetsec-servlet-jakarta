<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs + FindSecBugs exclusions for the spotbugs profile. -->
<FindBugsFilter>
	<!-- The only callers accept core-created Prepared results; no public arbitrary-URI redirect exists.
	     Core chooses an application-configured HTTPS IdP endpoint and signs the raw SAML query. -->
	<Match>
		<Class name="com.revetsec.servlet.jakarta.ServletSaml" />
		<Method name="writeRedirect" />
		<Bug pattern="UNVALIDATED_REDIRECT" />
	</Match>
</FindBugsFilter>
